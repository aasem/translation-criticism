{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasem.github.io/translation-criticism/schema/comparison.schema.json",
  "title": "Comparison of translations",
  "description": "Lines up two or more reports of the same source passage. All figures come from the member reports; this file holds only the members and the comparative prose.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "default": "",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "default": "",
          "description": "Display label; empty means the translator's name, else the submission label, else 'Translation k'."
        },
        "labelUr": {
          "type": "string",
          "default": "",
          "description": "Urdu twin of label"
        }
      },
      "required": [
        "id",
        "label",
        "labelUr"
      ],
      "default": {}
    }
  },
  "properties": {
    "schema": {
      "const": 2,
      "default": 2
    },
    "id": {
      "type": "string",
      "default": "",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "default": "",
      "minLength": 1
    },
    "titleUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of title"
    },
    "subtitle": {
      "type": "string",
      "default": "",
      "minLength": 1
    },
    "subtitleUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of subtitle"
    },
    "date": {
      "type": "string",
      "default": "",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "author": {
      "type": "string",
      "default": "",
      "minLength": 1
    },
    "authorUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of author"
    },
    "work": {
      "type": "string",
      "default": "",
      "minLength": 1
    },
    "workUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of work"
    },
    "originalWork": {
      "type": "string",
      "default": ""
    },
    "passage": {
      "type": "string",
      "default": ""
    },
    "passageUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of passage"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      },
      "minItems": 2,
      "default": []
    },
    "textNotes": {
      "type": "string",
      "default": ""
    },
    "textNotesUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of textNotes"
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "leadUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of lead"
    },
    "tendencies": {
      "type": "string",
      "default": ""
    },
    "tendenciesUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of tendencies"
    },
    "preferred": {
      "type": "string",
      "default": "",
      "description": "id of the preferred member"
    },
    "preferredBasis": {
      "type": "string",
      "default": ""
    },
    "preferredBasisUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of preferredBasis"
    },
    "note": {
      "type": "string",
      "default": "",
      "description": "One line for readers and publishers"
    },
    "noteUr": {
      "type": "string",
      "default": "",
      "description": "Urdu twin of note"
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "titleUr",
    "subtitle",
    "subtitleUr",
    "date",
    "author",
    "authorUr",
    "work",
    "workUr",
    "originalWork",
    "passage",
    "passageUr",
    "tags",
    "members",
    "textNotes",
    "textNotesUr",
    "lead",
    "leadUr",
    "tendencies",
    "tendenciesUr",
    "preferred",
    "preferredBasis",
    "preferredBasisUr",
    "note",
    "noteUr"
  ]
}
